<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App links: ссылка подтверждения почты из письма открывается в
                 приложении, а не в браузере — иначе сессия ставится в Chrome,
                 а в приложении человек остаётся невошедшим. Забираем только
                 /auth/*: остальной сайт (оферта, политика) должен по-прежнему
                 открываться браузером. Проверку подписи Google берёт из
                 https://wayback.skyforest.ai/.well-known/assetlinks.json —
                 там отпечаток ключа Play App Signing. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wayback.skyforest.ai" android:pathPrefix="/auth/confirm" />
                <data android:scheme="https" android:host="wayback.skyforest.ai" android:pathPrefix="/auth/callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Своя служба записи пути. Не экспортирована: поднимает её только
             наш плагин явным интентом, автозапуска нет (BOOT_COMPLETED мы не
             слушаем).

             stopWithTask="true" — сознательно. Смахнув приложение из недавних,
             человек уносит и WebView, то есть точки писать становится некому.
             Служба, пережившая задачу, показывала бы уведомление «записываем
             путь», не записывая ничего: уведомление не должно врать. -->
        <service
            android:name=".TrackService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="true" />

        <!-- Службу записи пути (foregroundServiceType="location") объявляет
             манифест плагина фоновой геолокации, она приходит слиянием. Но там
             она exported="true" — то есть запустить её могло бы любое
             приложение на телефоне. Своему процессу это не нужно: плагин
             привязывается к ней явным интентом. -->
        <service
            android:name="com.capgo.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- Приёмники геозон из того же манифеста нам не нужны: геозоны мы не
             используем, зато BOOT_COMPLETED — повод для вопросов и у ревью, и у
             человека, читающего список разрешений. -->
        <receiver
            android:name="com.capgo.capacitor_background_geolocation.GeofenceBroadcastReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.capgo.capacitor_background_geolocation.GeofenceBootReceiver"
            tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Проверка валидности сети на холодном старте (офлайн-редирект) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Геолокация для wayback-навигации (@capacitor/geolocation) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Запись пути со свёрнутым приложением и погашенным экраном держит служба
         переднего плана с постоянным уведомлением. Разрешения ниже приходят и из
         манифеста плагина, но перечислены здесь намеренно: по манифесту
         приложения должно быть видно, что оно делает в фоне.

         ACCESS_BACKGROUND_LOCATION здесь нет и добавлять его не нужно: службе
         переднего плана оно не требуется, а с ним пришлось бы проходить
         отдельную анкету Google с видео-обоснованием. Запись идёт только между
         «ушёл в поход» и «вернулся из похода», уведомление при этом висит на виду. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Приходит из манифеста плагина ради геозон, которыми мы не пользуемся. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <!-- Рекламы в приложении нет, рекламный идентификатор мы не читаем. Это
         разрешение приезжает слиянием из facebook-core — его тянет за собой
         плагин соц-входа (@capgo/capacitor-social-login) вместе с
         facebook-login, хотя Facebook-провайдер у нас не инициализируется:
         в socialAuth.ts есть только google и apple.

         Убираем не для красоты: Play Console сверяет анкету Advertising ID со
         сканом манифеста, и с этим разрешением пришлось бы отвечать «Yes» и
         объявлять рекламный идентификатор в Data safety. Ни того, ни другого мы
         не делаем, поэтому честный ответ «No» требует, чтобы разрешения в
         бандле не было. Google- и Apple-вход от этого не страдают: рекламный
         идентификатор нужен facebook-core для атрибуции рекламы, в коде плагина
         обращений к нему нет вовсе. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Плагин объявляет GPS обязательным; оставляем своё «не обязателен»,
         иначе Play молча сузит список поддерживаемых устройств. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false"
        tools:replace="android:required" />
</manifest>
