<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>WayBack</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Без этого ключа билд повисает в TestFlight со статусом Missing Compliance:
	  Apple ждёт ответа про экспортное шифрование. Своей криптографии в
	  приложении нет — только HTTPS, это исключение.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Purpose strings обязательны: без них iOS убивает процесс при первом
	  запросе, а загрузку отклоняют с ITMS-90683.

	  Приложение запрашивает только «when in use»: watchPosition
	  останавливается, когда приложение уходит в фон (см. syncTrackWatch
	  в TrackRecorder), фоновой записи трека нет. Поэтому UIBackgroundModes
	  здесь нет и быть не должно — заявленный, но неиспользуемый background
	  mode ревью отклоняет.

	  Строку «always» всё равно приходится держать: @capacitor/geolocation
	  линкует IONGeolocationLib, где в IONGLOCAuthorisationRequestType.swift
	  есть ветка с CLLocationManager.requestAlwaysAuthorization. Статический
	  анализ Apple видит ссылку на API в бинарнике (сам плагин зовёт только
	  .whenInUse) и требует ключ — без него прилетает ITMS-90683.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WayBack uses your location to mark the point where you entered the forest and to show the direction and distance back to it.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>WayBack records the path you walk so it can lead you back to the point where you entered the forest, even when there is no mobile signal. Your location is used only while WayBack is open on screen; the app does not follow you in the background.</string>
	<!-- Стрелка возврата работает по компасу телефона, когда курса GPS ещё нет. -->
	<key>NSMotionUsageDescription</key>
	<string>WayBack uses the compass to point the arrow toward your entry point while you are standing still.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!--
	  Приложение только для iPhone (TARGETED_DEVICE_FAMILY = 1), поэтому
	  варианта ориентаций ~ipad здесь нет.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!--
	  Google Sign-In возвращается в приложение по обратной схеме iOS-клиента
	  OAuth. Клиент привязан к bundle id, поэтому у WayBack он свой, отдельный
	  от ai.skyforest.app и от Checker: значение ниже — «iOS URL scheme» клиента
	  ai.skyforest.wayback из Google Cloud Console, и оно же (в прямом порядке)
	  должно лежать в NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID_WAYBACK.

	  Sign in with Apple схемы не требует (системный лист), но требует
	  entitlement com.apple.developer.applesignin — см. App/App.entitlements.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1052243839791-3hort2d3mgueuc32jkkmdbo000iev3i9</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
